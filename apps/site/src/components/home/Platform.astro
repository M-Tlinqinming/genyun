---
// 05 耕云平台（Paper W01「平台模块」）。2026-11-14 起只剩「应急预案生成」一张卡：
// 安全台账、培训 PPT、AI 隐患识别三张预告都删了，标题右侧的预告句也删了（见 DESIGN-DIFF）
import ContactTrigger from '../ContactTrigger.astro';
import ArrowIcon from '../ArrowIcon.astro';
---

<section class="plat" aria-labelledby="plat-title">
  <div class="wrap plat__inner">
    <div class="heading-stack">
      <p class="eyebrow">05 — 耕云平台</p>
      <h2 id="plat-title" class="h2">从一份预案开始，<br />管好全年的安全工作。</h2>
    </div>
    <div class="mod on-dark">
      <div class="mod__top">
        <span class="mod__pill">已上线</span>
      </div>
      <div class="mod__text">
        <h3>应急预案生成</h3>
        <p>按 GB/T 29639-2020，生成综合预案、专项预案、现场处置方案、风险评估报告与应急资源调查报告。</p>
      </div>
      <ContactTrigger class="text-link text-link--white">预约演示<ArrowIcon /></ContactTrigger>
    </div>
  </div>
</section>

<style>
  .plat {
    background: #fff;
  }
  .plat__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 120px;
  }
  .mod {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 36px;
    background: var(--gy-brand-ink);
    border-radius: 12px;
  }
  .mod__top {
    display: flex;
    align-items: center;
  }
  .mod__pill {
    padding: 4px 12px;
    border-radius: 999px;
    background: #75af762e;
    color: #a8d5a0;
    font-size: 12px;
    line-height: 20px;
  }
  .mod__text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mod__text h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    line-height: 38px;
    color: #fff;
  }
  .mod__text p {
    font-size: 14px;
    line-height: 25px;
    color: #ffffffad;
    text-wrap: pretty;
  }
  .mod :global(.text-link) {
    align-self: flex-start;
  }
  @media (max-width: 640px) {
    .plat__inner {
      padding-block: 80px;
    }
    .mod {
      padding: 28px;
    }
  }
</style>
