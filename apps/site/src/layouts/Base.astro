---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import ContactDialog from '../components/ContactDialog.astro';

interface Props {
  title: string;
  description: string;
  /** 法律页面在正式发布前不让搜索引擎收录 */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const fullTitle = title === '耕云' ? '耕云 · AI + 注册安全工程师编制应急预案' : `${title} · 耕云`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/og.jpg', Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#071A33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/noto-serif-sc-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-sans-sc-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="耕云" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="750" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // 首页入场前先把要入场的元素藏起来；减少动态时不藏。脚本万一没加载，2.5 秒后自动显示。
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var r = document.documentElement;
        r.classList.add('js-enter');
        setTimeout(function () { r.classList.remove('js-enter'); }, 2500);
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ContactDialog />
  </body>
</html>
