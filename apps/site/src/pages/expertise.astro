---
// 交付样例（Paper「10 · 官网与账户」/ W03 专业能力与样例）
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactTrigger from '../components/ContactTrigger.astro';

const industries = ['机械制造', '电子电器', '包装印刷', '化工仓储'];

// 已上线样例只有一份；其余两份客户授权、脱敏完成后上线
const coming = [
  { industry: '电子电器', title: '电子装配企业 · 脱敏样例' },
  { industry: '包装印刷', title: '包装印刷企业 · 脱敏样例' },
];

const docs = [
  // 文件名按 Paper 的断行（white-space: pre-line）
  { title: '生产安全事故\n应急预案', color: '#0068BD', height: 200, bars: [80, 60, 70] },
  { title: '风险评估\n报告', color: '#23A6AD', height: 176, bars: [80, 55] },
  { title: '应急资源\n调查报告', color: '#D9AE3A', height: 152, bars: [70] },
];

// 编号色：白底上 28px 大字至少 3:1。Paper 的 #23A6AD / #A3A23C / #D9AE3A 不够，压深一档，见 DESIGN-DIFF
const checks = [
  ['企业事实一致', '人数、设备、场所与您提供的资料逐项对得上。', '#0068BD'],
  ['危险源辨识完整', '按作业场所核对，不漏项；风险评分有依据。', '#008BCA'],
  ['预案与风险匹配', '专项预案和现场处置方案与辨识出的危险源一一对应。', '#1A8A90'],
  ['组织与联络有效', '应急分工到人，通讯录号码与花名册一致。', '#5E9E62'],
  ['属地信息准确', '应急管理局、街道、消防等机构以耕云知识库为准。', '#86852F'],
  ['三份文档同版', '预案、风险评估、资源调查引用同一份企业信息。', '#A47C14'],
];
---

<Base
  title="交付样例"
  description="耕云交付样例（已脱敏）与注册安全工程师的六项审核要点：企业事实、危险源辨识、预案与风险匹配、组织与联络、属地信息、三份文档同版。"
>
  <PageHeader slot="header" active="expertise" eyebrow="专业能力与样例">
    先看成果，<br />再做决定。
    <Fragment slot="aside">以下样例均已脱敏，结构与内容和真实交付一致。您可以直接对照自己的企业，判断是否适用。</Fragment>
  </PageHeader>

  <section class="samples" aria-label="脱敏样例">
    <div class="wrap samples__inner">
      <div class="filter">
        <div class="filter__chips" role="group" aria-label="按行业筛选">
          <button type="button" class="chip" aria-pressed="true" data-filter="">全部行业</button>
          {
            industries.map((name) => (
              <button type="button" class="chip" aria-pressed="false" data-filter={name}>
                {name}
              </button>
            ))
          }
        </div>
        <p class="filter__note" aria-live="polite" data-filter-note>样例持续补充中</p>
      </div>

      <div class="samples__list">
        <article class="sample sample--main" data-industry="机械制造">
          <div class="sample__cover" aria-hidden="true">
            {
              docs.map((d) => (
                <div class="doc" style={`height:${d.height}px;border-top-color:${d.color}`}>
                  <p>{d.title}</p>
                  {d.bars.map((w) => (
                    <i style={`width:${w}%`} />
                  ))}
                </div>
              ))
            }
          </div>
          <div class="sample__body">
            <ul class="tags">
              <li class="tag tag--blue">机械制造</li>
              <li class="tag">120 人</li>
              <li class="tag">涉及喷涂、可燃液体</li>
            </ul>
            <h2>工贸企业应急预案 · 脱敏样例</h2>
            <p>综合预案、火灾与容器爆炸专项预案、10 个现场处置方案，以及对应的风险评估和<span class="nobr">资源调查报告。</span></p>
            <ContactTrigger topic="sample" class="text-link">索取完整样例<span aria-hidden="true">→</span></ContactTrigger>
          </div>
        </article>

        <div class="samples__aside">
        {
          coming.map((c) => (
            <article class="sample sample--coming" data-industry={c.industry}>
              <div class="sample__top">
                <ul class="tags">
                  <li class="tag tag--warm">{c.industry}</li>
                  <li class="tag tag--warm">整理中</li>
                </ul>
                <h2>{c.title}</h2>
                <p>客户授权与脱敏完成后上线。</p>
              </div>
              <ContactTrigger topic="notify" item={c.title} class="text-link text-link--sm">
                上线时通知我
              </ContactTrigger>
            </article>
          ))
        }

        <p class="samples__empty" hidden data-filter-empty>这个行业的样例还在整理中。<button type="button" class="text-link text-link--sm" data-filter-go="机械制造">先看机械制造的样例</button>，或<ContactTrigger topic="sample" class="text-link text-link--sm">索取同行业样例</ContactTrigger>。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="checks" aria-labelledby="checks-title">
    <div class="wrap checks__inner">
      <div class="heading-row">
        <div class="heading-stack">
          <p class="eyebrow">专业能力 — 注安师审核要点</p>
          <h2 id="checks-title" class="h2 h2--sub">每一份交付前，<br />都要过这六关。</h2>
        </div>
        <p class="lead checks__lead">AI 起草提高效率，专业判断由注册安全工程师负责。以下是审核时逐项核对的内容。</p>
      </div>
      <ol class="checks__grid">
        {
          checks.map(([title, body, color], i) => (
            <li>
              <span class="checks__no" style={`color:${color}`}>{String(i + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<script>
  // 行业筛选：按钮切换 aria-pressed，隐藏不匹配的卡片。没有脚本时按钮不显示（见样式），全部卡片可见。
  const root = document.querySelector<HTMLElement>('.samples');
  if (root) {
    root.classList.add('js-filter');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-industry]')];
    const empty = root.querySelector<HTMLElement>('[data-filter-empty]');
    const note = root.querySelector<HTMLElement>('[data-filter-note]');
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const want = chip.dataset.filter ?? '';
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        let shown = 0;
        let coming = 0;
        for (const card of cards) {
          const match = !want || card.dataset.industry === want;
          card.hidden = !match;
          if (match) shown++;
          if (match && card.classList.contains('sample--coming')) coming++;
        }
        if (empty) empty.hidden = shown > 0;
        // 读屏软件通过 aria-live 听到筛选结果，例如「电子电器：1 份（整理中）」
        if (note) {
          const name = want || '全部行业';
          const detail = coming === 0 ? '' : coming === shown ? '（整理中）' : `（其中 ${coming} 份整理中）`;
          note.textContent = shown ? `${name}：${shown} 份${detail}` : `${name}：暂无样例`;
        }
      });
    }
    // 空状态里的「先看机械制造的样例」：切到对应行业，焦点放到那个筛选按钮上（按钮本身随空状态隐藏）
    for (const go of root.querySelectorAll<HTMLButtonElement>('[data-filter-go]')) {
      go.addEventListener('click', () => {
        const target = chips.find((c) => c.dataset.filter === go.dataset.filterGo);
        target?.click();
        target?.focus();
      });
    }
  }
</script>

<style>
  .samples__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 96px;
    padding-bottom: 120px;
  }
  .filter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .filter__chips {
    display: none;
    flex-wrap: wrap;
    gap: 8px;
  }
  .js-filter .filter__chips {
    display: flex;
  }
  .chip {
    border: 1px solid #d6d1c5;
    border-radius: 999px;
    padding: 7px 17px;
    background: transparent;
    color: var(--site-heading);
    font: inherit;
    font-size: 14px;
    line-height: 22px;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .chip:hover {
    border-color: var(--site-heading);
  }
  .chip[aria-pressed='true'] {
    background: var(--gy-brand-ink);
    border-color: var(--gy-brand-ink);
    color: #fff;
  }
  .filter__note {
    font-size: 14px;
    line-height: 22px;
    color: var(--site-muted-warm);
  }

  .samples__list {
    display: flex;
    gap: 32px;
  }
  .sample[hidden] {
    display: none;
  }
  .sample--main {
    flex: 1.3 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 12px;
    box-shadow: var(--shadow-doc);
    overflow: hidden;
  }
  .sample__cover {
    height: 260px;
    display: flex;
    align-items: flex-end;
    gap: 16px;
    padding-inline: 36px;
    background: var(--gy-brand-ink);
  }
  .doc {
    flex-shrink: 0;
    width: 150px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    background: #fff;
    border-top: 4px solid;
    border-radius: 4px 4px 0 0;
  }
  .doc p {
    margin-bottom: 4px;
    font-family: var(--font-serif);
    font-weight: 600;
    white-space: pre-line;
    font-size: 13px;
    line-height: 18px;
    color: var(--site-heading);
  }
  .doc i {
    height: 4px;
    border-radius: 2px;
    background: var(--site-line);
  }
  .sample__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 32px 36px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    border-radius: 4px;
    padding: 2px 10px;
    font-size: 12px;
    line-height: 20px;
    background: #f0f2f5;
    color: #596170;
  }
  .tag--blue {
    background: #eff4ff;
    color: var(--site-link);
  }
  .tag--warm {
    background: var(--site-line);
  }
  .sample h2 {
    text-wrap: balance;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 24px;
    line-height: 34px;
    color: var(--site-heading);
  }
  .sample p {
    /* 避免段落末行只剩一两个字（1366 宽主样例说明） */
    text-wrap: pretty;
    font-size: 14px;
    line-height: 24px;
    color: var(--site-body);
  }
  .sample--coming {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 32px;
    border: 1px dashed #c9c3b5;
    border-radius: 12px;
  }
  .sample__top {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sample--coming h2 {
    font-size: 20px;
    line-height: 30px;
  }
  .samples__aside {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .samples__empty {
    font-size: 15px;
    line-height: 26px;
    color: var(--site-body);
  }

  .checks {
    background: #fff;
  }
  .checks__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 120px;
  }
  .checks__lead {
    flex-shrink: 0;
    width: 420px;
  }
  .checks__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--site-line);
    border: 1px solid var(--site-line);
    border-radius: 12px;
    overflow: hidden;
  }
  .checks__grid li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    background: #fff;
  }
  .checks__no {
    font-family: var(--font-mono);
    font-size: 28px;
    line-height: 32px;
  }
  .checks__grid h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 20px;
    line-height: 30px;
    color: var(--site-heading);
  }
  .checks__grid p {
    font-size: 14px;
    line-height: 24px;
    color: var(--site-body);
  }

  /* 筛到只剩整理中的卡片时，右栏保持原来的宽度（1 / 2.3），不拉满整行；空状态的说明不受限 */
  @media (min-width: 1101px) {
    .samples__list:has(> .sample--main[hidden]) .samples__aside:not(:has(> [data-filter-empty]:not([hidden]))) {
      flex: 0 0 calc((100% - 32px) / 2.3);
    }
  }
  @media (max-width: 1100px) {
    .samples__list {
      flex-wrap: wrap;
    }
    .sample--main {
      flex-basis: 100%;
    }
    .checks__lead {
      width: auto;
      max-width: 560px;
    }
    .checks__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .samples__inner,
    .checks__inner {
      padding-block: 64px 72px;
      gap: 32px;
    }
    .samples__list {
      flex-direction: column;
    }
    .sample__cover {
      height: 200px;
      padding-inline: 20px;
      gap: 10px;
    }
    .doc {
      width: auto;
      flex: 1 1 0;
      min-width: 0;
      padding: 12px 10px;
    }
    .doc p {
      font-size: 11px;
      line-height: 16px;
    }
    .doc:nth-child(1) {
      height: 160px !important;
    }
    .doc:nth-child(2) {
      height: 140px !important;
    }
    .doc:nth-child(3) {
      height: 120px !important;
    }
    .sample__body,
    .sample--coming {
      padding: 24px;
    }
    .checks__grid {
      grid-template-columns: 1fr;
    }
    .checks__grid li {
      padding: 24px;
    }
  }
</style>
