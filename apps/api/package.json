{
  "name": "@genyun/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "sample:word": "tsx src/scripts/build-sample-word.ts",
    "sample:plan": "tsx --env-file-if-exists=.env src/scripts/build-sample-plan.ts",
    "sample:cases": "tsx --env-file-if-exists=.env src/scripts/build-test-cases.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@genyun/shared": "*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@node-rs/argon2": "2.2.2",
    "@resvg/resvg-js": "2.6.2",
    "cookie-parser": "1.4.7",
    "docx": "9.10.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "jszip": "3.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
