# 本机开发用的配置：复制本文件为同一目录下的 .env 再填写（.env 不进 git，密钥只放在那里）。
# 服务器上写在 /opt/genyun/.env，由 deploy/preview/compose.yml 传给应用。

# AI 起草服务：不填 = 不用 AI（全部用系统内容）；fake = 开发测试用的模拟；bailian = 阿里云百炼
AI_DRAFTER=bailian
# 阿里云百炼 API Key（百炼控制台 → API-KEY 管理，形如 sk-…）
DASHSCOPE_API_KEY=
# 模型，默认 qwen3.8-flash（Martin 10-29 定）；上线前在网信办已备案清单核对模型名称
AI_MODEL=qwen3.8-flash
# 接入地址：密钥按地域开，不能跨地域混用；不填 = 华北2（北京）
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 发信：mock = 模拟发信（默认；邮件写进 .data/mail-outbox，运营在 /operator/mail-outbox 查看）；aliyun = 阿里云邮件推送
# 正式环境（NODE_ENV=production）：不设、写错、或选 aliyun 但下面三项没填齐，启动就报错；
# 本机选 aliyun 但三项没填齐时先模拟发信（这时「模拟发件箱」不开放）
MAIL_DRIVER=mock
# 阿里云邮件推送：建一个只授权邮件推送（AliyunDirectMailFullAccess）的 RAM 子账号，用它的 AccessKey
# ALIYUN_DM_ACCESS_KEY_ID=
# ALIYUN_DM_ACCESS_KEY_SECRET=
# 邮件推送控制台里配好的发信地址
# ALIYUN_DM_ACCOUNT_NAME=noreply@mail.example.cn
# 收件人看到的发件人名称，默认「耕云」
# ALIYUN_DM_FROM_ALIAS=耕云
# 接口地址和地域，默认华东1（杭州）；用新加坡等地域时改成对应的
# ALIYUN_DM_ENDPOINT=https://dm.aliyuncs.com/
# ALIYUN_DM_REGION_ID=cn-hangzhou

# Word 转 PDF（专家 Word 校对页预览）用的 LibreOffice：本机指向 soffice.exe；服务器镜像里已装，不用填
# SOFFICE_PATH=D:\001-Project\tools\LibreOffice\program\soffice.exe
